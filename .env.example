
# AQUORA Environment Configuration Template
AQUORA_ENV=production
AQUORA_HOST=0.0.0.0
AQUORA_PORT=8000
AQUORA_DATABASE_URL=sqlite:///./aquora_offline.db

# Security & Authentication
# Replace these placeholders with private values in your local .env file
AQUORA_GATEWAY_API_KEY=replace_with_a_unique_gateway_key
AQUORA_SYNC_API_KEY=replace_with_a_real_sync_key_if_enabled

# Sensor & Stale Data Thresholds
AQUORA_STALE_SENSOR_TIMEOUT_SECONDS=1800
AQUORA_SURGE_THRESHOLD_CM=15.0

# Official Data Integration
AQUORA_TN_AGRI_URL=https://tnagriculture.in/ARS/home/reservoir/
AQUORA_CFM_URL=https://chennaifloodmonitor.tn.gov.in/HomePage/Dashboard
AQUORA_OFFICIAL_CACHE_TTL_MINUTES=60
AQUORA_HTTP_TIMEOUT_SECONDS=15

# Location & Weather Context (Default: Grand Anicut / Cauvery Delta Reach, TN)
AQUORA_LOCATION_NAME=Grand Anicut - Cauvery Lower Canal Reach
AQUORA_LATITUDE=10.8350
AQUORA_LONGITUDE=78.8180

# Offline Sync Configuration (Optional Upstream Endpoint)
AQUORA_SYNC_UPSTREAM_URL=https://sync.aquora.internal/api/v1/sync
AQUORA_AUTO_SYNC_ENABLED=false

